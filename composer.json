{
    "name": "flatrate/flarum-discussion-cards",
    "description": "High-context social-style discussion card presentation for FlatRate.wiki Flarum 1.8.",
    "keywords": [
        "flarum",
        "flatrate",
        "discussion",
        "cards"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "FlatRate.wiki",
            "homepage": "https://flatrate.wiki"
        }
    ],
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.8.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "FlatRate\\DiscussionCards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlatRate\\DiscussionCards\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:rollout": "php tests/run-rollout.php"
    },
    "extra": {
        "flarum-extension": {
            "title": "FlatRate Discussion Cards",
            "category": "feature",
            "icon": {
                "name": "fas fa-layer-group",
                "backgroundColor": "#111827",
                "color": "#ffffff"
            }
        }
    }
}
